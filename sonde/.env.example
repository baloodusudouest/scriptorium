# Copier ce fichier en « .env » (même dossier) et le remplir. Le fichier .env n'est jamais envoyé sur GitHub.

# Clé d'API Mistral (console.mistral.ai), gardée dans Enpass
MISTRAL_API_KEY=

# Modèle de vision servi par LM Studio sur ce PC (voie B, carte AMD).
# Laisser VISION_MODELE vide : le premier modèle chargé dans LM Studio est pris.
VISION_URL=http://host.docker.internal:1234/v1
VISION_MODELE=
