# Adresse de Scriptorium vue depuis le PC (adresse du NAS sur le réseau local, ou son nom Tailscale)
SCRIPTORIUM_URL=http://ADRESSE-DU-NAS:8091
# Même valeur que SCRIPTORIUM_JETON_CALCUL dans la stack du NAS (Portainer) ; 32 caractères au hasard
SCRIPTORIUM_JETON_CALCUL=
# Secondes entre deux demandes quand rien n'attend
CALCUL_ATTENTE=30
