# Variables à saisir dans Portainer (stack homelab.yml → Environment variables).
# Ce fichier ne contient que des exemples : aucune vraie valeur dans le dépôt.

# Mot de passe commun à toutes les applis (12 caractères au moins)
MAISON_PASSWORD=change-moi-12-caracteres-minimum
# Jeton commun des échanges entre applis maison : l'Anneau s'en sert pour sauvegarder les réglages de Scriptorium
# (GET /externe/sauvegarde) et Scriptorium pour lui redemander une sauvegarde (« Restaurer »). Vide : rien de tout ça.
MAISON_JETON=un-long-jeton-commun
# « oui » : aucune appli de la maison n'écrit chez un service extérieur
# MAISON_LECTURE_SEULE=oui

# Dossier du NAS pour l'état de Scriptorium (compter environ trois fois la taille de chaque PDF importé)
SCRIPTORIUM_DATA_DIR=/volume1/docker/scriptorium

# Dossier d'import (bookdrop) de Grimmory, tel qu'il est monté pour Grimmory
SCRIPTORIUM_BOOKDROP_DIR=/chemin/vers/le/bookdrop

# Clé d'API Mistral (console.mistral.ai) ; vide : la lecture n'est pas proposée
SCRIPTORIUM_MISTRAL_CLE=

# Jeton du PC de calcul (contre-lecture par Marker, voir pc/LISEZMOI.md) : 32 caractères au hasard,
# la même valeur dans le .env du PC. Vide : la porte du PC est fermée, pas de mots à relire.
SCRIPTORIUM_JETON_CALCUL=

# Facultatif
# PORT_SCRIPTORIUM=8091
# SCRIPTORIUM_VERSION=0.6.0

# « oui » : rien n'est envoyé à Mistral et rien n'est déposé dans Grimmory (premier jour d'une nouvelle version) ;
# « oui » ou « non » l'emporte sur MAISON_LECTURE_SEULE pour Scriptorium seul
SCRIPTORIUM_LECTURE_SEULE=

# Réglages d'usage : plus dans la stack depuis la 0.6. Recherche en ligne de la fiche, prix estimé par page et
# définition des pages se changent dans l'écran Réglages (repris une fois de SCRIPTORIUM_RECHERCHE_WEB,
# SCRIPTORIUM_PRIX_PAGE et SCRIPTORIUM_DPI au premier démarrage, puis ces variables ne sont plus lues).
